+
+fn print_optional_file(path: &str) {
+    let Ok(contents) = fs::read_to_string(path) else {
+        return;
+    };
+
+    if contents.is_empty() {
+        return;
+    }
+
+    print!("{contents}");
+
+    if !contents.ends_with('\n') {
+        println!();
+    }
+}
